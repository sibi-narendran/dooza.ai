{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "dooza-site",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Stage 1B: staging custom domain next.dooza.ai only (noindex via next.config.js headers + public/_headers).
	// www.dooza.ai and the apex are served by this Worker via zone routes since 2026-10-11.
	"workers_dev": true,
	"routes": [
		{ "pattern": "next.dooza.ai", "custom_domain": true },
		// Production cutover 2026-10-11 (Napoleon GO 13:47). DNS records stay as they were (proxied A/CNAME to Vercel);
		// these zone routes take the traffic. Rollback = delete these two routes (Vercel answers again at once).
		{ "pattern": "www.dooza.ai/*", "zone_name": "dooza.ai" },
		{ "pattern": "dooza.ai/*", "zone_name": "dooza.ai" }
	],
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by the memory queue for ISR revalidation (https://opennext.js.org/cloudflare/caching)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "dooza-site"
		}
	],
	// R2 is not enabled on the account (API code 10042), so the incremental cache is KV.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "cdd897cc943b4fbd88fb7b25d0eec5b4" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "31d1cd07c1ce4f098b6d839d31614b9a" }
	],
	"observability": { "enabled": true }
}
