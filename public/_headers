# Global Security Headers
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Sitemap
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

# RSS Feed
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Robots
/robots.txt
  Content-Type: text/plain; charset=utf-8

# Next.js build assets are content-hashed: cache forever (Cloudflare Workers static assets; OpenNext docs)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare staging hosts only: static assets get noindex (Worker-rendered pages get it from next.config.js headers()).
# Host-scoped rules, so they never apply to www.dooza.ai or dooza.ai.
https://next.dooza.ai/*
  X-Robots-Tag: noindex, nofollow

https://dooza-site.sibinarendran.workers.dev/*
  X-Robots-Tag: noindex, nofollow
